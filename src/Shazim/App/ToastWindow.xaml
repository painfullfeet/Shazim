<Window x:Class="Shazim.App.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Shazim.App.Infrastructure"
        Title="Shazim" Width="412" SizeToContent="Height" ResizeMode="NoResize" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" FontFamily="{StaticResource BodyFont}" UseLayoutRounding="True">
    <!-- Pop-up « morceau trouvé » : petite carte façon Shazim, au-dessus de la barre des tâches -->
    <Grid Margin="26" x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><TranslateTransform x:Name="Slide"/></Grid.RenderTransform>
        <!-- Aura : halo coloré qui respire autour de la carte -->
        <Border x:Name="Aura" CornerRadius="22" Margin="-6" Background="{DynamicResource SignalBrush}" Opacity="0.35"
                IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="AuraScale"/></Border.RenderTransform>
            <Border.Effect><BlurEffect Radius="22" KernelType="Gaussian"/></Border.Effect>
        </Border>
        <Border Background="{DynamicResource NightBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="Black"/>
            </Border.Effect>
        </Border>
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Width="64" Height="64" Cursor="Hand" MouseLeftButtonUp="OpenArea_Click">
                <Border CornerRadius="10" Background="{DynamicResource ArtPlaceholderBrush}">
                    <TextBlock x:Name="ArtInitial" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border CornerRadius="10">
                    <Border.Background><ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/></Border.Background>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OpenArea_Click">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SignalBrush}" VerticalAlignment="Center" Margin="0,1,6,0"/>
                    <TextBlock x:Name="BadgeText" Style="{StaticResource MutedText}" FontSize="11" Foreground="{DynamicResource SignalBrush}"/>
                </StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource BodyText}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="FavButton" Style="{StaticResource FavoriteToggle}" Width="36" Height="36" Click="Fav_Click"
                              ToolTip="{infra:T toast.favorite}" AutomationProperties.Name="{infra:T toast.favorite}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="{infra:T toast.open}" Padding="12,6" Margin="4,0,0,0" Click="Open_Click"/>
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconX}" Width="28" Height="28" FontSize="11" Margin="4,0,0,0"
                        VerticalAlignment="Top" ToolTip="{infra:T toast.close}" AutomationProperties.Name="{infra:T toast.close}" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
