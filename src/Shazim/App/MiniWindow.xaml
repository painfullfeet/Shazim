<Window x:Class="Shazim.App.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Shazim.App.Infrastructure"
        Title="Shazim – mini" Width="380" Height="96" ResizeMode="NoResize" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="{StaticResource BodyFont}" UseLayoutRounding="True">
    <Border Background="{DynamicResource NightBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="24"
            MouseLeftButtonDown="Drag" Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Bouton d'écoute compact -->
            <Button x:Name="ListenButton" Width="70" Height="70" Click="Listen_Click" Cursor="Hand" ToolTip="{infra:T miniwin.identifier_la_musique}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Halo" Stroke="{DynamicResource WaveBrush}" StrokeThickness="2" Opacity="0"/>
                            <Ellipse Margin="6" Fill="{DynamicResource SignalGradientBrush}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="busy">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Image x:Name="Glyph" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <infra:IconView x:Name="StopGlyph" Data="{StaticResource IconStopFill}" Foreground="White" Width="20" Height="20" Visibility="Collapsed"/>
                </Grid>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,8,0">
                <TextBlock x:Name="TitleText" Text="{infra:T miniwin.pret_a_ecouter}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SubText" Text="{infra:T miniwin.touchez_le_disque_pour_identifier}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconArrowsOut}" Width="32" Height="32" FontSize="14" ToolTip="{infra:T miniwin.ouvrir_la_fenetre_principale}" Click="Expand_Click"/>
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconX}" Width="32" Height="32" FontSize="13" ToolTip="{infra:T miniwin.fermer_le_mini_lecteur}" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
