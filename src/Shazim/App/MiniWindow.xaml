<Window x:Class="Shazim.App.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Shazim.App.Infrastructure"
        Title="Shazim – widget" Width="336" SizeToContent="Height" ResizeMode="NoResize" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="{StaticResource BodyFont}" UseLayoutRounding="True">
    <!-- Widget compact : pochette, titre, artiste, Auto Shazim, identifier, ligne des paroles -->
    <Border x:Name="Card" Background="{DynamicResource NightBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="18"
            Padding="10" MouseLeftButtonDown="Card_MouseDown" MouseLeftButtonUp="Card_MouseUp">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Pochette (ou le disque Shazim tant que rien n'est trouvé) -->
                <Grid Width="64" Height="64" ToolTip="{infra:T miniwin.ouvrir_la_fenetre_principale}">
                    <Border CornerRadius="12" Background="{DynamicResource ArtPlaceholderBrush}">
                        <TextBlock x:Name="ArtInitial" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="12">
                        <Border.Background><ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/></Border.Background>
                    </Border>
                    <Grid x:Name="IdleArt" Width="64" Height="64">
                        <Ellipse Fill="{DynamicResource SignalGradientBrush}"/>
                        <Image x:Name="Logo" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                    <TextBlock x:Name="TitleText" Text="{infra:T miniwin.pret_a_ecouter}" Style="{StaticResource BodyText}" FontSize="14"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubText" Text="{infra:T miniwin.touchez_le_disque_pour_identifier}" Style="{StaticResource MutedText}" FontSize="12"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Ellipse x:Name="AutoDot" Width="6" Height="6" Fill="{DynamicResource MistBrush}" VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock x:Name="AutoText" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Auto Shazim -->
                    <ToggleButton x:Name="AutoButton" Width="36" Height="36" Cursor="Hand" Click="Auto_Click" Margin="0,0,6,0"
                                  AutomationProperties.Name="{infra:T mainwin.auto_shazim}" ToolTip="{infra:T mainwin.auto_shazim}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Grid>
                                    <Ellipse x:Name="Disc" Fill="{DynamicResource DuskBrush}"/>
                                    <infra:IconView x:Name="Glyph" Data="{StaticResource IconMusicNotes}" Width="17" Height="17" Foreground="{DynamicResource MistBrush}"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource SignalSoftBrush}"/>
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SignalBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Disc" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <!-- Identifier -->
                    <Button x:Name="ListenButton" Width="44" Height="44" Click="Listen_Click" Cursor="Hand"
                            ToolTip="{infra:T miniwin.identifier_la_musique}" AutomationProperties.Name="{infra:T miniwin.identifier_la_musique}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse x:Name="Halo" Stroke="{DynamicResource WaveBrush}" StrokeThickness="2" Opacity="0"/>
                                    <Ellipse Margin="3" Fill="{DynamicResource SignalGradientBrush}"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Tag" Value="busy">
                                        <Setter TargetName="Halo" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <infra:IconView x:Name="ListenGlyph" Data="{StaticResource IconWaveform}" Foreground="White" Width="18" Height="18"/>
                            <infra:IconView x:Name="StopGlyph" Data="{StaticResource IconStopFill}" Foreground="White" Width="14" Height="14" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Fermer : visible au survol -->
                <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource IconButton}" Tag="{StaticResource IconX}" Width="20" Height="20" FontSize="9"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0" Opacity="0" Click="Close_Click"
                        ToolTip="{infra:T miniwin.fermer_le_mini_lecteur}" AutomationProperties.Name="{infra:T miniwin.fermer_le_mini_lecteur}"/>
            </Grid>

            <!-- Paroles synchronisées : ligne en cours + suivante -->
            <StackPanel x:Name="LyricsPanel" Margin="4,10,4,2" Visibility="Collapsed">
                <TextBlock x:Name="LyricNow" Style="{StaticResource BodyText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource PaperBrush}"/>
                <TextBlock x:Name="LyricNext" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Opacity="0.75"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
