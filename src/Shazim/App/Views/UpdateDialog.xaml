<UserControl x:Class="Shazim.App.Views.UpdateDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Shazim.App.Infrastructure">
    <!-- Carte « Mise à jour disponible », posée au-dessus de la fenêtre principale -->
    <Border Background="{DynamicResource NightBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="22"
            Width="460" Padding="26,24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Grid Width="48" Height="48" Margin="0,0,16,0">
                    <Ellipse Fill="{DynamicResource SignalGradientBrush}"/>
                    <infra:IconView Data="{StaticResource IconDownload}" Foreground="White" Width="22" Height="22"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" FontSize="19"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="NotesText" Style="{StaticResource BodyText}" FontSize="13" Margin="0,18,0,0" TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" MaxHeight="150" LineHeight="20" Foreground="{DynamicResource MistBrush}"/>

            <!-- Téléchargement -->
            <StackPanel x:Name="ProgressPanel" Margin="0,18,0,0" Visibility="Collapsed">
                <Border x:Name="ProgressTrack" Height="6" CornerRadius="3" Background="{DynamicResource DuskBrush}">
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{DynamicResource SignalBrush}"/>
                </Border>
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                       TextTrimming="None" Visibility="Collapsed"/>

            <WrapPanel Margin="0,22,0,0">
                <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Content="{infra:T update.install}" Margin="0,0,10,0" Click="Update_Click"/>
                <Button x:Name="LaterButton" Style="{StaticResource SecondaryButton}" Content="{infra:T update.later}" Margin="0,0,10,0" Click="Later_Click"/>
                <Button x:Name="SkipButton" Style="{StaticResource GhostButton}" Content="{infra:T update.skip}" Click="Skip_Click"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
