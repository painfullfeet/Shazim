<UserControl x:Class="Shazim.App.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Shazim.App.Infrastructure">
    <UserControl.Resources>
        <Style x:Key="TileValue" TargetType="TextBlock" BasedOn="{StaticResource DisplayText}">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <!-- Ligne « nom ··· barre ··· nombre » des classements -->
        <DataTemplate x:Key="RankRow">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Rank}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontSize="13"/>
                    <Border Height="4" CornerRadius="2" Background="{DynamicResource DuskBrush}" Margin="0,5,0,0">
                        <Border HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource SignalBrush}" Width="{Binding BarWidth}"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,4,40,32" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{infra:T stats.title}" Style="{StaticResource PageTitle}" Margin="0,0,0,18"/>

            <!-- Rien encore -->
            <Border x:Name="EmptyPanel" Style="{StaticResource Panel}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" Margin="0,24">
                    <infra:IconView Data="{StaticResource IconChartBar}" Width="40" Height="40" Foreground="{DynamicResource MistBrush}"/>
                    <TextBlock Text="{infra:T stats.empty}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock Text="{infra:T stats.empty_hint}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="StatsBody">
                <!-- Chiffres -->
                <UniformGrid Rows="1" Margin="0,0,0,22">
                    <Border Style="{StaticResource Panel}" Margin="0,0,12,0">
                        <StackPanel><TextBlock x:Name="TracksValue" Style="{StaticResource TileValue}"/><TextBlock Text="{infra:T stats.tracks}" Style="{StaticResource TileLabel}"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,0,12,0">
                        <StackPanel><TextBlock x:Name="PlaysValue" Style="{StaticResource TileValue}"/><TextBlock Text="{infra:T stats.plays}" Style="{StaticResource TileLabel}"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,0,12,0">
                        <StackPanel><TextBlock x:Name="MonthValue" Style="{StaticResource TileValue}"/><TextBlock Text="{infra:T stats.this_month}" Style="{StaticResource TileLabel}"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel><TextBlock x:Name="FavValue" Style="{StaticResource TileValue}"/><TextBlock Text="{infra:T stats.favorites}" Style="{StaticResource TileLabel}"/></StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 30 derniers jours -->
                <DockPanel Margin="0,0,0,10">
                    <TextBlock x:Name="DaysTotal" DockPanel.Dock="Right" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Bottom"/>
                    <TextBlock Text="{infra:T stats.last_days}" Style="{StaticResource SectionTitle}"/>
                </DockPanel>
                <Border Style="{StaticResource Panel}" Margin="0,0,0,22">
                    <StackPanel>
                        <ItemsControl x:Name="DaysChart" Height="120">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" ToolTip="{Binding Tip}" Margin="2,0">
                                        <Border VerticalAlignment="Bottom" Height="{Binding BarHeight}" CornerRadius="3,3,1,1"
                                                Background="{DynamicResource SignalBrush}" Opacity="{Binding BarOpacity}" MinHeight="2"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,8,0,0">
                            <TextBlock x:Name="DaysStart" Style="{StaticResource MutedText}" FontSize="11"/>
                            <TextBlock Text="{infra:T stats.today}" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Moments forts -->
                <TextBlock Text="{infra:T stats.highlights}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                <UniformGrid x:Name="Highlights" Rows="1" Margin="0,0,0,22"/>

                <!-- Classements -->
                <UniformGrid Rows="1" Margin="0,0,0,22">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{infra:T stats.top_artists}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <Border Style="{StaticResource Panel}">
                            <ItemsControl x:Name="ArtistList" ItemTemplate="{StaticResource RankRow}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{infra:T stats.top_genres}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <Border Style="{StaticResource Panel}">
                            <ItemsControl x:Name="GenreList" ItemTemplate="{StaticResource RankRow}"/>
                        </Border>
                    </StackPanel>
                </UniformGrid>

                <!-- Sources -->
                <TextBlock Text="{infra:T stats.sources}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                <Border Style="{StaticResource Panel}">
                    <ItemsControl x:Name="SourceList" ItemTemplate="{StaticResource RankRow}"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
