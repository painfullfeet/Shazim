<UserControl x:Class="Shazim.App.Views.TrackDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Shazim.App.Views"
             xmlns:infra="clr-namespace:Shazim.App.Infrastructure">
    <UserControl.Resources>
        <Style x:Key="InfoLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <!-- Fond : la pochette, floutée, comme une fiche Shazam -->
        <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.45" VerticalAlignment="Top" Height="420" Margin="-60">
            <Image.Effect><BlurEffect Radius="70" KernelType="Gaussian" RenderingBias="Performance"/></Image.Effect>
        </Image>
        <Rectangle VerticalAlignment="Top" Height="420">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{DynamicResource InkTintColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource InkColor}" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="Body" Margin="36,24,36,28">
                <!-- En-tête -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="ArtBox" Width="200" Height="200" VerticalAlignment="Top">
                        <Border CornerRadius="12" Background="{DynamicResource ArtPlaceholderBrush}">
                            <TextBlock x:Name="ArtInitial" Style="{StaticResource DisplayText}" FontSize="72" Opacity="0.85"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="12">
                            <Border.Background><ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/></Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="26,4,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Badge" Style="{StaticResource MutedText}" FontSize="12" Foreground="{DynamicResource SignalBrush}"/>
                        <TextBlock x:Name="TitleText" Style="{StaticResource DisplayText}" FontSize="34" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="88" Margin="0,4,0,0"/>
                        <TextBlock x:Name="ArtistText" Style="{StaticResource BodyText}" FontSize="19" Foreground="{DynamicResource MistBrush}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="MetaText" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>

                        <WrapPanel Margin="0,18,0,0">
                            <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Padding="18,10" Margin="0,0,10,8" Click="Play_Click">
                                <StackPanel Orientation="Horizontal">
                                    <infra:IconView x:Name="PlayIcon" Data="{StaticResource IconPlayFill}" Width="15" Height="15" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PlayText" Text="{infra:T library.ecouter_l_extrait}"/>
                                </StackPanel>
                            </Button>
                            <local:VolumeButton Margin="0,0,4,8" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="FavButton" Style="{StaticResource FavoriteToggle}" Width="44" Height="44" Margin="0,0,4,8" Click="Fav_Click"/>
                            <Button Style="{StaticResource IconButton}" Width="44" Height="44" Tag="{StaticResource IconCopy}" ToolTip="{infra:T trackdetail.copier_artiste_titre}" Margin="0,0,4,8" Click="Copy_Click"/>
                            <Button x:Name="ShazamButton" Style="{StaticResource IconButton}" Width="44" Height="44" Tag="{StaticResource IconGlobe}" ToolTip="{infra:T trackdetail.voir_la_page_du_morceau}" Margin="0,0,4,8" Click="Shazam_Click"/>
                            <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Width="44" Height="44" Tag="{StaticResource IconTrash}" ToolTip="{infra:T trackdetail.supprimer_de_la_bibliotheque}" Margin="0,0,4,8" Click="Delete_Click"/>
                        </WrapPanel>
                        <!-- Progression de l'extrait -->
                        <Border x:Name="PreviewTrack" Height="3" CornerRadius="2" Background="{DynamicResource LineBrush}" MaxWidth="320" HorizontalAlignment="Left"
                                Width="320" Visibility="Hidden">
                            <Border x:Name="PreviewBar" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="{DynamicResource SignalBrush}"/>
                        </Border>
                        <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Disponible sur -->
                <StackPanel x:Name="PlatformsSection" Margin="0,30,0,0">
                    <TextBlock Text="{infra:T trackdetail.disponible_sur}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                    <WrapPanel x:Name="PlatformsPanel"/>
                </StackPanel>

                <!-- Paroles (synchronisées quand le morceau passe en ce moment) -->
                <StackPanel x:Name="LyricsSection" Margin="0,22,0,0" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel x:Name="NudgePanel" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource GhostButton}" Content="− 0,5 s" Padding="10,4" Click="NudgeEarlier_Click"
                                    ToolTip="{infra:T lyrics.earlier}" AutomationProperties.Name="{infra:T lyrics.earlier}"/>
                            <TextBlock x:Name="NudgeText" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="6,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="+ 0,5 s" Padding="10,4" Click="NudgeLater_Click"
                                    ToolTip="{infra:T lyrics.later}" AutomationProperties.Name="{infra:T lyrics.later}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{infra:T lyrics.title}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="LyricsBadge" Style="{StaticResource MutedText}" FontSize="12" Foreground="{DynamicResource SignalBrush}"
                                       VerticalAlignment="Bottom" Margin="12,0,0,2"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Panel}" Padding="22,14">
                        <ScrollViewer x:Name="LyricsScroller" MaxHeight="320" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel x:Name="LyricsLines"/>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="{infra:T lyrics.source}" Style="{StaticResource MutedText}" FontSize="11" Margin="2,6,0,0"/>
                </StackPanel>

                <!-- Informations -->
                <TextBlock Text="{infra:T trackdetail.informations}" Style="{StaticResource SectionTitle}" Margin="0,22,0,12"/>
                <Border Style="{StaticResource Panel}" Padding="22,16">
                    <UniformGrid x:Name="InfoGrid" Columns="3"/>
                </Border>

                <!-- Historique des écoutes -->
                <StackPanel x:Name="HistorySection" Margin="0,22,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="HistoryTitle" Text="{infra:T trackdetail.historique}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SignalBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding When}" Style="{StaticResource BodyText}" FontSize="13"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding How}" Style="{StaticResource MutedText}" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
