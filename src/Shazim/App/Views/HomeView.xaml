<UserControl x:Class="Shazim.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Shazim.App.Infrastructure"
             Focusable="True">
    <Grid>
        <!-- ===== Écoute ===== -->
        <Grid x:Name="ListenPanel">
            <Rectangle Fill="{DynamicResource AccentGlowBrush}" IsHitTestVisible="False"/>
            <Grid Margin="40,0,40,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" Text="{infra:T home.touchez_pour_shazimer}" Style="{StaticResource DisplayText}" FontSize="34" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,34"/>

                    <!-- Le bouton : ondes qui se propagent pendant l'écoute -->
                    <Button x:Name="ListenButton" Width="300" Height="300" Click="Listen_Click" Cursor="Hand"
                            PreviewMouseLeftButtonDown="Listen_Press" PreviewMouseLeftButtonUp="Listen_Release" MouseLeave="Listen_Release"
                            AutomationProperties.Name="{infra:T miniwin.identifier_la_musique}" FocusVisualStyle="{x:Null}" RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform><ScaleTransform x:Name="PressScale"/></Button.RenderTransform>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent"><ContentPresenter/></Grid>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Ellipse x:Name="Ripple1" Width="196" Height="196" Fill="{DynamicResource SignalSoftBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Ripple2" Width="196" Height="196" Fill="{DynamicResource SignalSoftBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Ripple3" Width="196" Height="196" Fill="{DynamicResource SignalSoftBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Pulsation : un anneau part du bouton à chaque temps -->
                            <Ellipse x:Name="BeatRing1" Width="196" Height="196" Stroke="{DynamicResource SignalBrush}" StrokeThickness="5"
                                     Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="BeatRing1Scale"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="BeatRing2" Width="196" Height="196" Stroke="{DynamicResource SignalBrush}" StrokeThickness="5"
                                     Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="BeatRing2Scale"/></Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Aura qui épouse le spectre de la musique (inspirée de Specterr) : trois couches lissées -->
                            <Grid x:Name="Aura" Width="300" Height="300" IsHitTestVisible="False" ClipToBounds="False">
                                <Path x:Name="AuraOuter" Stretch="None" Fill="{DynamicResource SignalBrush}" Opacity="0.28">
                                    <Path.Effect>
                                        <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.9" Color="{DynamicResource SignalColor}"/>
                                    </Path.Effect>
                                </Path>
                                <Path x:Name="AuraMiddle" Stretch="None" Fill="{DynamicResource SignalBrush}" Opacity="0.6"/>
                                <Path x:Name="AuraInner" Stretch="None" Fill="{DynamicResource SignalDeepBrush}" Stroke="White"
                                      StrokeThickness="1.6" StrokeLineJoin="Round" Opacity="0.95"/>
                            </Grid>

                            <!-- Anneau de progression -->
                            <Path x:Name="ProgressArc" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="220" Height="220" Opacity="0.85" Visibility="Collapsed"/>

                            <!-- Glow that breathes behind the button -->
                            <Ellipse x:Name="Halo" Width="250" Height="250" IsHitTestVisible="False" Opacity="0.55" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="{DynamicResource SignalColor}" Offset="0.55"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.RenderTransform><ScaleTransform x:Name="HaloScale"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Grid x:Name="CoreBreath" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><ScaleTransform x:Name="BreathScale"/></Grid.RenderTransform>
                            <Grid x:Name="Core" Width="196" Height="196" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><ScaleTransform x:Name="CoreScale"/></Grid.RenderTransform>
                                <Ellipse Fill="{DynamicResource SignalGradientBrush}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.55" Color="Black"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Image x:Name="LogoImage" Width="84" Height="84" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <Path x:Name="CoreGlyph" Fill="White" Stretch="Uniform" Width="70" Height="70" IsHitTestVisible="False"
                                      Data="M0,4 h2 v6 h-2 z M3.5,1 h2 v12 h-2 z M7,3 h2 v8 h-2 z M10.5,5 h2 v4 h-2 z"/>
                            </Grid>
                            </Grid>
                        </Grid>
                    </Button>

                    <TextBlock x:Name="StatusDetail" Style="{StaticResource MutedText}" FontSize="14" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None" MaxWidth="380" Margin="0,30,0,0"
                               Text="{infra:T home.reconnait_la_musique_jouee_sur}"/>
                    <Button x:Name="SourceButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Center" Margin="0,12,0,0"
                            Click="Source_Click" ToolTip="{infra:T home.choisir_ce_qu_il_faut}">
                        <Border CornerRadius="14" Background="{DynamicResource HoverBrush}" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <infra:IconView x:Name="SourceIcon" Data="{StaticResource IconSpeakerHigh}" Width="15" Height="15" Foreground="{DynamicResource MistBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SourceText" Text="{infra:T home.son_du_pc}" FontSize="12" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.7"/>
                </StackPanel>

                <!-- Récemment -->
                <Grid Grid.Row="1" x:Name="RecentSection" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{infra:T home.voir_la_bibliotheque}" Click="AllHistory_Click"/>
                        <TextBlock Text="{infra:T home.recemment}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl x:Name="RecentList" Grid.Row="1">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" Columns="6"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BaseButton}" Padding="6" Margin="0,0,8,0" HorizontalContentAlignment="Stretch"
                                        Click="Recent_Click" Tag="{Binding}" ToolTip="{Binding Title}"
                                        AutomationProperties.Name="{Binding AccessibleName}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="44" Height="44">
                                            <Border CornerRadius="6" Background="{DynamicResource ArtPlaceholderBrush}">
                                                <TextBlock Text="{Binding Initial}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border CornerRadius="6">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding ArtUrl, Converter={StaticResource Artwork}, ConverterParameter=44}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Artist}" Style="{StaticResource MutedText}" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== Résultat ===== -->
        <Grid x:Name="ResultPanel" Visibility="Collapsed">
            <ContentControl x:Name="DetailHost" Focusable="False"/>
            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,0,0,0"
                    Click="Back_Click" ToolTip="{infra:T home.revenir_au_bouton_d_ecoute}">
                <StackPanel Orientation="Horizontal">
                    <infra:IconView Data="{StaticResource IconArrowLeft}" Width="15" Height="15" Foreground="{DynamicResource MistBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{infra:T home.shazimer_a_nouveau}"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
