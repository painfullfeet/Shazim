<UserControl x:Class="Shazim.App.Views.VolumeButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Shazim.App.Infrastructure">
    <Grid>
        <ToggleButton x:Name="Toggle" Style="{StaticResource IconButton}" Tag="{StaticResource IconSpeakerLow}"
                      ToolTip="{infra:T volumebutton.volume_des_extraits}" AutomationProperties.Name="{infra:T volumebutton.volume_des_extraits}"/>
        <Popup x:Name="Panel" PlacementTarget="{Binding ElementName=Toggle}" Placement="Top" VerticalOffset="-6"
               HorizontalOffset="-90" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}">
            <Border Background="{StaticResource NightBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="14,10" Margin="0,0,12,12">
                <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5"/></Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Tag="{StaticResource IconSpeakerLow}"
                            Width="32" Height="32" FontSize="16" Click="Mute_Click" ToolTip="{infra:T volumebutton.couper_ou_remettre_le_son}"
                            AutomationProperties.Name="{infra:T volumebutton.couper_le_son}"/>
                    <Slider x:Name="VolumeSlider" Width="170" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                            Margin="8,0,12,0" VerticalAlignment="Center" ValueChanged="Volume_Changed"
                            AutomationProperties.Name="{infra:T volumebutton.volume_des_extraits}"/>
                    <TextBlock x:Name="PercentText" Style="{StaticResource BodyText}" FontSize="13" Width="38"
                               VerticalAlignment="Center" TextAlignment="Right"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
