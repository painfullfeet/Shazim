<UserControl x:Class="Shazim.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Shazim.App.Views"
             xmlns:infra="clr-namespace:Shazim.App.Infrastructure">
    <Grid Margin="40,4,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <TextBlock Text="{infra:T mainwin.bibliotheque}" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="CountText" Style="{StaticResource MutedText}" FontSize="14" VerticalAlignment="Bottom" Margin="14,0,0,5"/>
        </StackPanel>

        <!-- Barre d'outils -->
        <Grid Grid.Row="1" Margin="0,0,8,14" x:Name="Toolbar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MaxWidth="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" Padding="34,0,10,0" TextChanged="Search_TextChanged" AutomationProperties.Name="{infra:T library.rechercher}"/>
                <infra:IconView Data="{StaticResource IconMagnifyingGlass}" Width="16" Height="16" Foreground="{DynamicResource MistBrush}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
                <TextBlock Text="{infra:T library.titre_artiste_ou_album}" Style="{StaticResource MutedText}" Margin="35,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"/>
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource NightBrush}" CornerRadius="8" Padding="3" Margin="10,0,0,0" Height="40">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FilterAll" Style="{StaticResource SegmentItem}" Content="{infra:T library.tous}" GroupName="filter" IsChecked="True" Checked="Filter_Checked"/>
                    <RadioButton x:Name="FilterFav" Style="{StaticResource SegmentItem}" GroupName="filter" Checked="Filter_Checked">
                        <StackPanel Orientation="Horizontal">
                            <infra:IconView Data="{StaticResource IconHeartFill}" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource SignalBrush}"/>
                            <TextBlock Text="{infra:T library.favoris}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <local:VolumeButton Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>

            <ComboBox x:Name="SortCombo" Grid.Column="3" Width="170" Margin="10,0,0,0" SelectionChanged="Sort_Changed"
                      AutomationProperties.Name="{infra:T library.trier}">
                <ComboBoxItem Content="{infra:T library.recents}" Tag="Recent" IsSelected="True"/>
                <ComboBoxItem Content="{infra:T library.plus_ecoutes}" Tag="MostPlayed"/>
                <ComboBoxItem Content="{infra:T library.artiste_a_z}" Tag="Artist"/>
                <ComboBoxItem Content="{infra:T library.titre_a_z}" Tag="Title"/>
            </ComboBox>

            <Button Grid.Column="4" x:Name="ExportButton" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Height="40" Click="Export_Click"
                    ToolTip="{infra:T library.exporter_la_bibliotheque_csv_ou}">
                <infra:IconView Data="{StaticResource IconExport}" Width="18" Height="18"/>
            </Button>
        </Grid>

        <!-- Liste -->
        <ListBox x:Name="TrackList" Grid.Row="2" Style="{StaticResource RowList}" AutomationProperties.Name="{infra:T library.morceaux}"
                 PreviewMouseLeftButtonUp="TrackList_Click" KeyDown="TrackList_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="56" Background="Transparent" Cursor="Hand" ToolTip="{infra:T library.voir_la_fiche_du_morceau}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pochette + bouton de lecture de l'extrait -->
                        <Grid Width="56" Height="56" x:Name="ArtCell">
                            <Border CornerRadius="8" Background="{DynamicResource ArtPlaceholderBrush}">
                                <TextBlock Text="{Binding Initial}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="8">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding ArtUrl, Converter={StaticResource Artwork}, ConverterParameter=56}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Button x:Name="PlayButton" Width="56" Height="56" Click="Play_Click" Tag="{Binding}" Cursor="Hand"
                                    AutomationProperties.Name="{infra:T library.ecouter_l_extrait}"
                                    ToolTip="{infra:T library.ecouter_l_extrait}" Opacity="0"
                                    Visibility="{Binding HasPreview, Converter={StaticResource VisibleWhen}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8" Background="#99000000">
                                            <Grid Width="30" Height="30">
                                                <Ellipse Fill="{DynamicResource SignalBrush}"/>
                                                <infra:IconView Data="{Binding PlayIcon}" Width="13" Height="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,12,0">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Artist}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Album}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CountLabel}" Style="{StaticResource BodyText}" FontSize="12"/>
                            <TextBlock Text="{Binding LastHeardLabel}" Style="{StaticResource MutedText}" FontSize="11"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="4" Style="{StaticResource FavoriteToggle}" IsChecked="{Binding IsFavorite, Mode=OneWay}"
                                      VerticalAlignment="Center" Click="Favorite_Click"/>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="PlayButton" Property="Opacity" Value="1"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter TargetName="PlayButton" Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- État vide -->
        <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" MaxWidth="380">
            <infra:IconView x:Name="EmptyIcon" Data="{StaticResource IconMusicNotes}" Width="44" Height="44" Foreground="{DynamicResource LineBrush}"/>
            <TextBlock x:Name="EmptyTitle" Style="{StaticResource SectionTitle}" FontSize="20" HorizontalAlignment="Center" Margin="0,14,0,6"/>
            <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None"/>
            <Button x:Name="EmptyAction" Style="{StaticResource PrimaryButton}" Content="{infra:T library.shazimer_un_morceau}" HorizontalAlignment="Center"
                    Margin="0,18,0,0" Click="EmptyAction_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
